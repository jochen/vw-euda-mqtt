# VW-ID / myVolkswagen Zugangsdaten (auch fürs EU-Data-Act-Portal)
VW_USERNAME=deine@email.de
VW_PASSWORD=deinPasswort
# VW_VIN=WVWZZZABCD1234567   # optional, sonst erstes Fahrzeug im Portal

# Optional: eigene Variablennamen fürs EUDA-Portal (Vorrang vor VW_USERNAME/PASSWORD)
# EUDA_EMAIL=deine@email.de
# EUDA_PASSWORD=deinPasswort
# EUDA_COUNTRY=si            # OIDC-state Land (Default si)
# EUDA_LANGUAGE=sl           # OIDC-state Sprache (Default sl) — bei DE-Login-Problemen de/de testen

# MQTT Broker
MQTT_BROKER=192.168.1.10
MQTT_PORT=1883
MQTT_BASE_TOPIC=ohm/car/id3
# MQTT_USER=mqttuser          # optional
# MQTT_PASSWORD=mqttpass      # optional

# evcc integration (SOC interpolation while charging)
EVCC_BASE_TOPIC=ohm/evcc
EVCC_LOADPOINT=1
VEHICLE_CAPACITY_KWH=58
SOC_LIVE_SUBTOPIC=soc_live
INTERP_INTERVAL_S=60
CHARGE_EFFICIENCY=1.0
