# VW-ID / myVolkswagen Zugangsdaten (auch fürs EU-Data-Act-Portal)
VW_USERNAME=deine@email.de
VW_PASSWORD=deinPasswort
# VW_VIN=WVWZZZABCD1234567   # optional, sonst erstes Fahrzeug im Portal

# Optional: eigene Variablennamen fürs EUDA-Portal (Vorrang vor VW_USERNAME/PASSWORD)
# EUDA_EMAIL=deine@email.de
# EUDA_PASSWORD=deinPasswort
# EUDA_COUNTRY=si            # OIDC-state Land (Default si)
# EUDA_LANGUAGE=sl           # OIDC-state Sprache (Default sl) — bei DE-Login-Problemen de/de testen

# MQTT Broker
MQTT_BROKER=192.168.1.10
MQTT_PORT=1883
MQTT_BASE_TOPIC=ohm/car/id3
# MQTT_USER=mqttuser          # optional
# MQTT_PASSWORD=mqttpass      # optional

# evcc integration (SOC interpolation while charging)
EVCC_BASE_TOPIC=ohm/evcc
EVCC_LOADPOINT=1
VEHICLE_CAPACITY_KWH=58
SOC_LIVE_SUBTOPIC=soc_live
INTERP_INTERVAL_S=60
CHARGE_EFFICIENCY=1.0
# Manuell gemeldeter SOC (z. B. aus der VW-App): Zahl auf dieses Topic publizieren
# SOC_MANUAL_TOPIC=ohm/car/id3/soc_manual/set
# soc_live wird zurückgehalten, wenn das Portal so lange (s) nichts geliefert hat
# → evcc-timeout greift statt mit eingefrorenem Wert weiterzuladen.
SOC_STALE_AFTER_S=2700
# soc_live wird non-retained jeden Tick neu publiziert (Fail-Safe für evcc:
# bei Service-Ausfall greift evccs timeout statt auf altem Wert weiterzuladen).
# Auf true setzen, falls du den Wert in HA auch nach Neustart sofort sehen willst.
SOC_LIVE_RETAIN=false
# Fahrten seit dem Anker abziehen (km aus mileage.value × Verbrauch)
DRIVE_KWH_PER_KM=0.22
# Manueller SOC sperrt VW-Werte für MANUAL_LOCK_H Stunden / MANUAL_LOCK_KM km;
# Abweichungen > SOC_TOLERANCE_PCT gehen als JSON auf <base>/soc_conflict
SOC_TOLERANCE_PCT=3
MANUAL_LOCK_H=24
MANUAL_LOCK_KM=30
# SOC_CONFLICT_TOPIC=ohm/car/id3/soc_conflict
# Ladeleistung auf gemessenen Hausverbrauch (Fronius via evcc) minus Grundlast deckeln; -1 = aus
HOME_BASE_LOAD_W=300
