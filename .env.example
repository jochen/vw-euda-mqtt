# WeConnect Zugangsdaten (VW-ID / myVolkswagen Account)
VW_USERNAME=deine@email.de
VW_PASSWORD=deinPasswort
# VW_VIN=WVWZZZABCD1234567   # optional, nur wenn mehrere Fahrzeuge

# MQTT Broker
MQTT_BROKER=192.168.1.x
MQTT_PORT=1883
MQTT_TOPIC=car/id3/soc
